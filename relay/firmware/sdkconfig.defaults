# Drifted relay on the M5Stack NanoC6 (ESP32-C6, 4 MB flash, no PSRAM).
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Updates over the network (relay/ota.py): two app slots, roll back if a new image never comes up healthy.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# The USB-C port is the console: logs out, setup commands in.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Bluetooth LE: NimBLE, central only, one connection.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144

# Wi-Fi and Bluetooth share one 2.4 GHz radio; software coexistence time-slices it.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

CONFIG_LWIP_MAX_SOCKETS=10
# Small TCP segments. A relay sits wherever the table is, often with a weak Wi-Fi signal, and there long
# packets are the ones that get lost (measured: no loss at 400 bytes, 25% at 1400), which stalls a connection
# for seconds at a time. Nothing here needs throughput: the largest transfer is a firmware update.
CONFIG_LWIP_TCP_MSS=536
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
